{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conversation Assistant",
  "version": "0.0.0",
  "identifier": "app.conversation.assistant",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build:ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "dashboard",
        "title": "Conversation Assistant — Dashboard",
        "width": 1100,
        "height": 750
      },
      {
        "label": "overlay",
        "title": "Conversation Assistant — Teleprompter",
        "width": 640,
        "height": 480,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
